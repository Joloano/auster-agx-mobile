# Referência das opções aceitas pelo aplicativo.
# Em tempo de execução os valores são passados via --dart-define.
# Exemplo: flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080

# Origem HTTP(S) do backend, sem caminho, query, fragmento ou credenciais.
API_BASE_URL=http://10.0.2.2:8080

# Timeout das requisições HTTP, em milissegundos.
API_TIMEOUT_MS=10000

# Libera HTTP sem TLS. Padrão: true em debug e false em release.
ALLOW_INSECURE_HTTP=false
